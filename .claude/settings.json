{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(~/.routa/**)",
      "Edit(~/.routa/**)",
      "Bash(*.routa*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-token-check.ts\""
          }
        ]
      }
    ]
  }
}
